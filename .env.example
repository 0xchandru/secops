# ================================
# SecOps Console — Environment Variables
# ================================

# PostgreSQL
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops_pass
POSTGRES_DB=secops
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# API Server
PORT=8080
JWT_SECRET=change-me-in-production
NODE_ENV=production
DATABASE_URL=postgresql://secops:secops_pass@postgres:5432/secops

# Syslog Receiver
ENABLE_SYSLOG=false
SYSLOG_UDP_PORT=1514
SYSLOG_TCP_PORT=1514

# Pipeline Worker
ENABLE_WORKER=false

# Frontend
FRONTEND_PORT=80
