# ──────────────────────────────────────────────────────────────────────────────
# SecOps Backend — Environment Variables
# Copy this file to .env and fill in your values before running the backend.
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development          # development | production


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Full connection URL — the only variable the app strictly requires.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/secops

# Optional individual PG vars (used by some CLI tools like psql / drizzle-kit)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=secops


# ── JWT — REQUIRED ────────────────────────────────────────────────────────────
# Both secrets MUST be set or logins will fail with "secretOrPrivateKey must have a value".
# Use long random strings in production (e.g. openssl rand -hex 64).
JWT_SECRET=change-me-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-string


# ── Redis (optional) ──────────────────────────────────────────────────────────
# If not set the app runs without caching / job queue (degraded but functional).
REDIS_URL=redis://localhost:6379


# ── ThreatLens enrichment (optional) ─────────────────────────────────────────
# If not set, IOC enrichment is skipped gracefully.
THREATLENS_API_URL=http://localhost:8000
THREATLENS_TIMEOUT_MS=5000


# ── Optional receivers ────────────────────────────────────────────────────────
ENABLE_SYSLOG=false           # Set to true to start the syslog UDP/TCP receiver
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=601
ENABLE_WORKER=false           # Set to true to run the inline pipeline worker
